  "adversary": {
    "verdict": "ROBUST within the bounded two-block source, numerical, lifetime, cache-integrity and descriptive timing contract.",
    "lineage": "Correlated same-family Mini-Quad; not independent replication.",
    "checked": "Live report/argv/guard/source/binary and metadata hashes, fixture/cache identity bindings, full first/last/changed-input poisoned replay results, memory telemetry and static ownership/order checks. Larger payload sizes checked; root streamed their full hashes.",
    "residual": "Synthetic inputs, adapted MPS oracle rather than compiled CUDA Flex, selected blocks only, unverified full-file LFS hash, opaque MPS allocations and sampled memory. No full generation, pixel quality or controlled loading-speed claim."
  },
  "limitations": [
    "Only actual pretrained decoder layers zero and one.",
    "Full J compares attention/output only; small J compares all 52 stages.",
    "Synthetic initial hidden states, not real full-decoder states.",
    "No complete decoder, diffusion, video, pixel quality or full-generation latency result.",
    "Only two-block BF16 cache; no full-file checkpoint hash verification.",
    "CPU fixture preparation, startup I/O and post-terminal analysis are outside GPU neural math.",
    "Named counters exclude opaque MPS allocations.",
    "Source/cache generation pinning is not hermetic attestation; final cache validator re-executed after source-identity validation hardening.",
    "External artifacts are required for exact replay."
  ],
