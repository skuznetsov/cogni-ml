describe ML::GGUF::Qwen35CPU do
  it "returns the final layer hidden in chunk-off prefill" do
    File.tempfile("chunkoff") do |file|
      file.write(GGUF_FIXTURE)
      file.flush
      weights = ML::GGUF::Qwen35Weights.from_gguf(file.path)
      begin
        ENV["QWEN35_ATTN_CPU"] = "1"
        ENV["QWEN35_HEAD_TOP1_FUSED"] = "0"
        reference_state = ML::GGUF::Qwen35CPU::State.new(weights.hparams, max_seq: 4)
        ML::GGUF::Qwen35CPU.forward_hidden(weights, 0_i32, 0_i32, reference_state)
        reference = ML::GGUF::Qwen35CPU.forward_hidden(weights, 1_i32, 1_i32, reference_state)

        old = ENV["QWEN35_PREFILL_CHUNK_OFF"]?
        ENV["QWEN35_PREFILL_CHUNK_OFF"] = "1"
        begin
          actual_state = ML::GGUF::Qwen35CPU::State.new(weights.hparams, max_seq: 4)
          actual = ML::GGUF::Qwen35CPU.prefill_tokens_last_hidden(weights, [0_i32, 1_i32], 0_i32, actual_state)
          actual.should eq(reference)
        ensure
          if old
            ENV["QWEN35_PREFILL_CHUNK_OFF"] = old
          else
            ENV.delete("QWEN35_PREFILL_CHUNK_OFF")
          end
        end
      end
    end
  end
end
