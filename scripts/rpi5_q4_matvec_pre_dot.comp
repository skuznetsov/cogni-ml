#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer WBuffer {
  uint w[];
};

layout(set = 0, binding = 1) readonly buffer XBuffer {
  float x[];
};

layout(set = 0, binding = 2) writeonly buffer YBuffer {
  float y[];
};

layout(push_constant) uniform Push {
  uint out_dim;
  uint in_dim;
  uint row_bytes;
  uint repeats;
} pc;

vec4 q4_lo_to_vec4(uint word) {
  return vec4(
    float((word >> 0u) & 0x0fu),
    float((word >> 4u) & 0x0fu),
    float((word >> 8u) & 0x0fu),
    float((word >> 12u) & 0x0fu));
}

vec4 q4_hi_to_vec4(uint word) {
  return vec4(
    float((word >> 16u) & 0x0fu),
    float((word >> 20u) & 0x0fu),
    float((word >> 24u) & 0x0fu),
    float((word >> 28u) & 0x0fu));
}

vec4 x_vec4(uint base) {
  return vec4(x[base], x[base + 1u], x[base + 2u], x[base + 3u]);
}

void main() {
  uint row = gl_GlobalInvocationID.x;
  if (row >= pc.out_dim) {
    return;
  }

  uint groups = pc.in_dim / 32u;
  uint row_word_off = (row * pc.row_bytes) >> 2u;
  float sum = 0.0;
  for (uint g = 0u; g < groups; g++) {
    uint block_word = row_word_off + g * 6u;
    float scale = uintBitsToFloat(w[block_word]);
    float minv = uintBitsToFloat(w[block_word + 1u]);
    vec4 mv = vec4(minv);
    uint x_base = g * 32u;
    for (uint q = 0u; q < 4u; q++) {
      uint qw = w[block_word + 2u + q];
      uint xb = x_base + q * 8u;
      vec4 qlo = scale * q4_lo_to_vec4(qw) - mv;
      vec4 qhi = scale * q4_hi_to_vec4(qw) - mv;
      sum += dot(x_vec4(xb), qlo);
      sum += dot(x_vec4(xb + 4u), qhi);
    }
  }
  y[row] = sum;
}
