#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer GateBuffer {
  float gate[];
};

layout(set = 0, binding = 1) readonly buffer UpBuffer {
  float up[];
};

layout(set = 0, binding = 2) writeonly buffer MidBuffer {
  float mid[];
};

layout(push_constant) uniform Push {
  uint n;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.n) {
    return;
  }
  float g = gate[i];
  mid[i] = (g / (1.0 + exp(-g))) * up[i];
}
