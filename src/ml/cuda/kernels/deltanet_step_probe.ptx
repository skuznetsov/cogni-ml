    add.rn.f32 %f2, %f2, %f13;
    cvt.rn.f32.u32 %f14, %r1;
    div.rn.f32 %f15, %f2, %f14;
    add.rn.f32 %f15, %f15, %f1;
    sqrt.rn.f32 %f16, %f15;
    rcp.rn.f32 %f17, %f16;
    st.shared.f32 [%rd11], %f17;
ADDRMSP_INV_DONE:
    bar.sync 0;

    ld.shared.f32 %f18, [%rd11];
    mov.u32 %r12, %r2;
ADDRMSP_WRITE:
    setp.ge.u32 %p1, %r12, %r1;
    @%p1 bra ADDRMSP_DONE;
    mul.wide.u32 %rd6, %r12, 4;
    add.s64 %rd7, %rd4, %rd6;
