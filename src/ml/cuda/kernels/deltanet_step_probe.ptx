    add.u32 %r6, %r2, 64;
    mul.wide.u32 %rd15, %r6, 4;
    add.s64 %rd16, %rd11, %rd15;
    ld.shared.f32 %f7, [%rd16];
    add.rn.f32 %f2, %f2, %f7;
    st.shared.f32 [%rd12], %f2;
ADDRMSP_R64_DONE:
    bar.sync 0;

    setp.ge.u32 %p4, %r2, 32;
    @%p4 bra ADDRMSP_R32_DONE;
    ld.shared.f32 %f2, [%rd12];
    add.u32 %r7, %r2, 32;
    mul.wide.u32 %rd17, %r7, 4;
    add.s64 %rd18, %rd11, %rd17;
    ld.shared.f32 %f8, [%rd18];
    add.rn.f32 %f2, %f2, %f8;
    st.shared.f32 [%rd12], %f2;
ADDRMSP_R32_DONE:
