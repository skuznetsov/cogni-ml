ADDRMSP_STORE_SUM:
    mul.wide.u32 %rd10, %r2, 4;
    cvta.shared.u64 %rd11, smem;
    add.s64 %rd12, %rd11, %rd10;
    st.shared.f32 [%rd12], %f2;
