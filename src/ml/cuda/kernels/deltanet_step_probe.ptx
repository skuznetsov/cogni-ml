}

.visible .entry swiglu_probe(
    .param .u64 gate,
    .param .u64 up,
    .param .u64 out,
    .param .u32 dim
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<14>;

    ld.param.u64 %rd1, [gate];
    ld.param.u64 %rd2, [up];
    ld.param.u64 %rd3, [out];
    ld.param.u32 %r1, [dim];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.s32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra SWI_DONE;

    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    mov.f32 %f3, 0fBFB8AA3B;
    mul.rn.f32 %f4, %f1, %f3;
    ex2.approx.ftz.f32 %f5, %f4;
    mov.f32 %f6, 0f3F800000;
    add.rn.f32 %f7, %f6, %f5;
    rcp.approx.ftz.f32 %f8, %f7;
    mul.rn.f32 %f9, %f1, %f8;
    mul.rn.f32 %f10, %f9, %f2;
    st.global.f32 [%rd7], %f10;

SWI_DONE:
    ret;
}

.visible .entry add_vec_probe(
    .param .u64 a,
    .param .u64 b,
    .param .u64 out,
    .param .u32 dim
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<4>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [out];
    ld.param.u32 %r1, [dim];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.s32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra ADD_DONE;

    mul.wide.u32 %rd4, %r5, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    add.rn.f32 %f3, %f1, %f2;
    st.global.f32 [%rd7], %f3;

ADD_DONE:
    ret;
}
