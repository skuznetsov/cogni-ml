.version 8.0
.target sm_80
.address_size 64

// Correctness-first CUDA DeltaNet step probe for Qwen recurrent shape s=128.
//
// One thread computes one value-head state row. The kernel keeps the algorithm
// intentionally direct:
//   state[h, row, :] *= g[h]
//   sk = dot(state[h, row, :], k[h % h_k, :])
//   delta = beta[h] * (v[h, row] - sk)
//   state[h, row, :] += k[h % h_k, :] * delta
//   y[h, row] = dot(state[h, row, :], q[h % h_k, :]) * scale
//
// Launch: grid=(h_v), block=(128).
.visible .entry deltanet_step_128_probe(
    .param .u64 state,
    .param .u64 q,
    .param .u64 k,
    .param .u64 v,
    .param .u64 g,
    .param .u64 beta,
    .param .u64 y,
    .param .u32 h_k,
    .param .u32 h_v,
    .param .f32 scale
)
{
    .reg .pred %p<6>;
    .reg .b32 %r<42>;
    .reg .b64 %rd<50>;
    .reg .f32 %f<20>;

    ld.param.u64 %rd1, [state];
    ld.param.u64 %rd2, [q];
    ld.param.u64 %rd3, [k];
    ld.param.u64 %rd4, [v];
    ld.param.u64 %rd5, [g];
    ld.param.u64 %rd6, [beta];
    ld.param.u64 %rd7, [y];
    ld.param.u32 %r1, [h_k];
    ld.param.u32 %r2, [h_v];
    ld.param.f32 %f1, [scale];

    mov.u32 %r3, %ctaid.x;       // h
    mov.u32 %r4, %tid.x;         // row/d2
    setp.ge.u32 %p1, %r3, %r2;
    @%p1 bra DONE;
    setp.ge.u32 %p2, %r4, 128;
    @%p2 bra DONE;

    rem.u32 %r5, %r3, %r1;       // k head = h % h_k

    // state row element offset = h * 16384 + row * 128.
    mul.lo.u32 %r6, %r3, 16384;
    shl.b32 %r7, %r4, 7;
    add.u32 %r8, %r6, %r7;

    // q/k base = (h % h_k) * 128; v/y base = h * 128.
    shl.b32 %r9, %r5, 7;
    shl.b32 %r10, %r3, 7;
    add.u32 %r11, %r10, %r4;

    // Load scalar head parameters and v[h,row].
    mul.wide.u32 %rd8, %r3, 4;
    add.s64 %rd9, %rd5, %rd8;
    ld.global.f32 %f2, [%rd9];   // gh
    add.s64 %rd10, %rd6, %rd8;
    ld.global.f32 %f3, [%rd10];  // beta

    mul.wide.u32 %rd11, %r11, 4;
    add.s64 %rd12, %rd4, %rd11;
    ld.global.f32 %f4, [%rd12];  // v[h,row]

    mov.f32 %f5, 0f00000000;     // sk
    mov.u32 %r12, 0;             // d1

DECAY_DOT_LOOP:
    setp.ge.u32 %p3, %r12, 128;
    @%p3 bra UPDATE_PREP;

    add.u32 %r13, %r8, %r12;
    mul.wide.u32 %rd13, %r13, 4;
    add.s64 %rd14, %rd1, %rd13;
    ld.global.f32 %f6, [%rd14];  // old state
    mul.rn.f32 %f7, %f6, %f2;    // decayed state
    st.global.f32 [%rd14], %f7;

    add.u32 %r14, %r9, %r12;
    mul.wide.u32 %rd15, %r14, 4;
    add.s64 %rd16, %rd3, %rd15;
    ld.global.f32 %f8, [%rd16];  // k
    fma.rn.f32 %f5, %f7, %f8, %f5;

    add.u32 %r12, %r12, 1;
    bra DECAY_DOT_LOOP;

UPDATE_PREP:
    sub.rn.f32 %f9, %f4, %f5;
    mul.rn.f32 %f10, %f9, %f3;   // delta
    mov.f32 %f11, 0f00000000;    // acc
    mov.u32 %r15, 0;

UPDATE_LOOP:
    setp.ge.u32 %p4, %r15, 128;
    @%p4 bra STORE_Y;

    add.u32 %r16, %r8, %r15;
    mul.wide.u32 %rd17, %r16, 4;
    add.s64 %rd18, %rd1, %rd17;
    ld.global.f32 %f12, [%rd18]; // decayed state

    add.u32 %r17, %r9, %r15;
    mul.wide.u32 %rd19, %r17, 4;
    add.s64 %rd20, %rd3, %rd19;
    ld.global.f32 %f13, [%rd20]; // k
    fma.rn.f32 %f14, %f13, %f10, %f12;
    st.global.f32 [%rd18], %f14;

    add.s64 %rd21, %rd2, %rd19;
    ld.global.f32 %f15, [%rd21]; // q
    fma.rn.f32 %f11, %f14, %f15, %f11;

    add.u32 %r15, %r15, 1;
    bra UPDATE_LOOP;

STORE_Y:
    mul.rn.f32 %f16, %f11, %f1;
    mul.wide.u32 %rd22, %r11, 4;
    add.s64 %rd23, %rd7, %rd22;
    st.global.f32 [%rd23], %f16;

DONE:
    ret;
}

// Serial correctness-first post-processing:
//   y[h, d] = RMSNorm(y[h, :], norm) * silu(z[h, d])
//
// Launch: grid=(h_v), block=(1). The serial per-head shape is intentional for
// this boundary probe; the next optimized version should parallelize the 128-d
// reduction and vector update.
.visible .entry deltanet_post_norm_gate_128_probe(
    .param .u64 y,
    .param .u64 z,
    .param .u64 norm,
    .param .u32 h_v,
    .param .f32 eps
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<18>;
    .reg .b64 %rd<22>;
    .reg .f32 %f<26>;

    ld.param.u64 %rd1, [y];
    ld.param.u64 %rd2, [z];
    ld.param.u64 %rd3, [norm];
    ld.param.u32 %r1, [h_v];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %ctaid.x;       // h
    mov.u32 %r3, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra POST_DONE;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra POST_DONE;

    shl.b32 %r4, %r2, 7;         // base = h * 128
    mov.f32 %f2, 0f00000000;     // sumsq
    mov.u32 %r5, 0;

POST_SUM_LOOP:
    setp.ge.u32 %p3, %r5, 128;
    @%p3 bra POST_INV;

    add.u32 %r6, %r4, %r5;
    mul.wide.u32 %rd4, %r6, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f3, [%rd5];
    fma.rn.f32 %f2, %f3, %f3, %f2;

    add.u32 %r5, %r5, 1;
    bra POST_SUM_LOOP;

POST_INV:
    mov.f32 %f4, 0f3C000000;     // 1 / 128
    mul.rn.f32 %f5, %f2, %f4;
    add.rn.f32 %f5, %f5, %f1;
    sqrt.rn.f32 %f6, %f5;
    rcp.rn.f32 %f7, %f6;         // inv_rms
    mov.u32 %r7, 0;

POST_WRITE_LOOP:
    setp.ge.u32 %p4, %r7, 128;
    @%p4 bra POST_DONE;

    add.u32 %r8, %r4, %r7;
    mul.wide.u32 %rd6, %r8, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    ld.global.f32 %f8, [%rd7];   // y
    ld.global.f32 %f9, [%rd8];   // z

    mul.wide.u32 %rd9, %r7, 4;
    add.s64 %rd10, %rd3, %rd9;
    ld.global.f32 %f10, [%rd10]; // norm[d]

    mov.f32 %f11, 0fBFB8AA3B;    // -log2(e)
    mul.rn.f32 %f12, %f9, %f11;
    ex2.approx.ftz.f32 %f13, %f12;
    mov.f32 %f14, 0f3F800000;    // 1.0
    add.rn.f32 %f15, %f14, %f13;
    rcp.approx.ftz.f32 %f16, %f15;
    mul.rn.f32 %f17, %f9, %f16;  // silu(z)
    mul.rn.f32 %f18, %f8, %f7;
    mul.rn.f32 %f19, %f18, %f10;
    mul.rn.f32 %f20, %f19, %f17;
    st.global.f32 [%rd7], %f20;

    add.u32 %r7, %r7, 1;
    bra POST_WRITE_LOOP;

POST_DONE:
    ret;
}

// Same math as deltanet_post_norm_gate_128_probe, but writes the post-gated
// row to a separate output pointer. This lets known-span recurrent runners
// keep the DeltaNet state update serial while batching the following ssm_out
// projection over token-major rows.
.visible .entry deltanet_post_norm_gate_128_store_probe(
    .param .u64 y,
    .param .u64 z,
    .param .u64 norm,
    .param .u64 out,
    .param .u32 h_v,
    .param .f32 eps
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<18>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<26>;

    ld.param.u64 %rd1, [y];
    ld.param.u64 %rd2, [z];
    ld.param.u64 %rd3, [norm];
    ld.param.u64 %rd22, [out];
    ld.param.u32 %r1, [h_v];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %ctaid.x;       // h
    mov.u32 %r3, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra POSTS_DONE;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra POSTS_DONE;

    shl.b32 %r4, %r2, 7;         // base = h * 128
    mov.f32 %f2, 0f00000000;     // sumsq
    mov.u32 %r5, 0;

POSTS_SUM_LOOP:
    setp.ge.u32 %p3, %r5, 128;
    @%p3 bra POSTS_INV;

    add.u32 %r6, %r4, %r5;
    mul.wide.u32 %rd4, %r6, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f3, [%rd5];
    fma.rn.f32 %f2, %f3, %f3, %f2;

    add.u32 %r5, %r5, 1;
    bra POSTS_SUM_LOOP;

POSTS_INV:
    mov.f32 %f4, 0f3C000000;     // 1 / 128
    mul.rn.f32 %f5, %f2, %f4;
    add.rn.f32 %f5, %f5, %f1;
    sqrt.rn.f32 %f6, %f5;
    rcp.rn.f32 %f7, %f6;         // inv_rms
    mov.u32 %r7, 0;

POSTS_WRITE_LOOP:
    setp.ge.u32 %p4, %r7, 128;
    @%p4 bra POSTS_DONE;

    add.u32 %r8, %r4, %r7;
    mul.wide.u32 %rd6, %r8, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd21, %rd22, %rd6;
    ld.global.f32 %f8, [%rd7];   // y
    ld.global.f32 %f9, [%rd8];   // z

    mul.wide.u32 %rd9, %r7, 4;
    add.s64 %rd10, %rd3, %rd9;
    ld.global.f32 %f10, [%rd10]; // norm[d]

    mov.f32 %f11, 0fBFB8AA3B;    // -log2(e)
    mul.rn.f32 %f12, %f9, %f11;
    ex2.approx.ftz.f32 %f13, %f12;
    mov.f32 %f14, 0f3F800000;    // 1.0
    add.rn.f32 %f15, %f14, %f13;
    rcp.approx.ftz.f32 %f16, %f15;
    mul.rn.f32 %f17, %f9, %f16;  // silu(z)
    mul.rn.f32 %f18, %f8, %f7;
    mul.rn.f32 %f19, %f18, %f10;
    mul.rn.f32 %f20, %f19, %f17;
    st.global.f32 [%rd21], %f20;

    add.u32 %r7, %r7, 1;
    bra POSTS_WRITE_LOOP;

POSTS_DONE:
    ret;
}

// Single-token recurrent convolution + SiLU prep.
//
// Launch: enough threads to cover qkv_dim (8192 for Qwen3.5 9B).
.visible .entry recurrent_conv1d_silu_step_probe(
    .param .u64 conv_state,
    .param .u64 qkv,
    .param .u64 conv_w,
    .param .u64 out,
    .param .u32 qkv_dim
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<30>;
    .reg .f32 %f<20>;

    ld.param.u64 %rd1, [conv_state];
    ld.param.u64 %rd2, [qkv];
    ld.param.u64 %rd3, [conv_w];
    ld.param.u64 %rd4, [out];
    ld.param.u32 %r1, [qkv_dim];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.s32 %r5, %r3, %r4, %r2;  // ch
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra CONV_DONE;

    mul.wide.u32 %rd5, %r5, 4;
    add.s64 %rd6, %rd1, %rd5;       // state[0,ch]
    add.s64 %rd7, %rd2, %rd5;       // qkv[ch]
    add.s64 %rd8, %rd4, %rd5;       // out[ch]

    add.u32 %r6, %r5, %r1;
    mul.wide.u32 %rd9, %r6, 4;
    add.s64 %rd10, %rd1, %rd9;      // state[1,ch]

    add.u32 %r7, %r6, %r1;
    mul.wide.u32 %rd11, %r7, 4;
    add.s64 %rd12, %rd1, %rd11;     // state[2,ch]

    shl.b32 %r8, %r5, 2;            // ch * conv_k
    mul.wide.u32 %rd13, %r8, 4;
    add.s64 %rd14, %rd3, %rd13;     // conv_w[ch,0]

    ld.global.f32 %f1, [%rd6];
    ld.global.f32 %f2, [%rd10];
    ld.global.f32 %f3, [%rd12];
    ld.global.f32 %f4, [%rd7];
    ld.global.f32 %f5, [%rd14];
    add.s64 %rd15, %rd14, 4;
    ld.global.f32 %f6, [%rd15];
    add.s64 %rd16, %rd14, 8;
    ld.global.f32 %f7, [%rd16];
    add.s64 %rd17, %rd14, 12;
    ld.global.f32 %f8, [%rd17];

    mul.rn.f32 %f9, %f1, %f5;
    fma.rn.f32 %f9, %f2, %f6, %f9;
    fma.rn.f32 %f9, %f3, %f7, %f9;
    fma.rn.f32 %f9, %f4, %f8, %f9;

    mov.f32 %f10, 0fBFB8AA3B;       // -log2(e)
    mul.rn.f32 %f11, %f9, %f10;
    ex2.approx.ftz.f32 %f12, %f11;
    mov.f32 %f13, 0f3F800000;
    add.rn.f32 %f14, %f13, %f12;
    rcp.approx.ftz.f32 %f15, %f14;
    mul.rn.f32 %f16, %f9, %f15;     // silu(acc)
    st.global.f32 [%rd8], %f16;

    st.global.f32 [%rd6], %f2;
    st.global.f32 [%rd10], %f3;
    st.global.f32 [%rd12], %f4;

CONV_DONE:
    ret;
}

// Serial per-head L2 normalization for a [heads,128] buffer.
.visible .entry l2_norm_128_probe(
    .param .u64 x,
    .param .u32 heads,
    .param .f32 eps
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<14>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<12>;

    ld.param.u64 %rd1, [x];
    ld.param.u32 %r1, [heads];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %tid.x;
    setp.ge.u32 %p1, %r2, %r1;
    @%p1 bra L2_DONE;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra L2_DONE;

    shl.b32 %r4, %r2, 7;
    mov.f32 %f2, 0f00000000;
    mov.u32 %r5, 0;

L2_SUM:
    setp.ge.u32 %p3, %r5, 128;
    @%p3 bra L2_SCALE_PREP;
    add.u32 %r6, %r4, %r5;
    mul.wide.u32 %rd2, %r6, 4;
    add.s64 %rd3, %rd1, %rd2;
    ld.global.f32 %f3, [%rd3];
    fma.rn.f32 %f2, %f3, %f3, %f2;
    add.u32 %r5, %r5, 1;
    bra L2_SUM;

L2_SCALE_PREP:
    add.rn.f32 %f4, %f2, %f1;
    sqrt.rn.f32 %f5, %f4;
    rcp.rn.f32 %f6, %f5;
    mov.u32 %r7, 0;

L2_WRITE:
    setp.ge.u32 %p4, %r7, 128;
    @%p4 bra L2_DONE;
    add.u32 %r8, %r4, %r7;
    mul.wide.u32 %rd4, %r8, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f7, [%rd5];
    mul.rn.f32 %f8, %f7, %f6;
    st.global.f32 [%rd5], %f8;
    add.u32 %r7, %r7, 1;
    bra L2_WRITE;

L2_DONE:
    ret;
}

// Transform projected alpha/beta into DeltaNet ghead/beta:
//   beta = sigmoid(beta_raw)
//   g    = exp(softplus(alpha + dt_bias) * ssm_a)
.visible .entry alpha_beta_transform_probe(
    .param .u64 alpha,
    .param .u64 beta_raw,
    .param .u64 dt_bias,
    .param .u64 ssm_a,
    .param .u64 g_out,
    .param .u64 beta_out,
    .param .u32 h_v
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<30>;

    ld.param.u64 %rd1, [alpha];
    ld.param.u64 %rd2, [beta_raw];
    ld.param.u64 %rd3, [dt_bias];
    ld.param.u64 %rd4, [ssm_a];
    ld.param.u64 %rd5, [g_out];
    ld.param.u64 %rd6, [beta_out];
    ld.param.u32 %r1, [h_v];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mad.lo.s32 %r5, %r3, %r4, %r2;
    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra AB_DONE;

    mul.wide.u32 %rd7, %r5, 4;
    add.s64 %rd8, %rd1, %rd7;
    add.s64 %rd9, %rd2, %rd7;
    add.s64 %rd10, %rd3, %rd7;
    add.s64 %rd11, %rd4, %rd7;
    add.s64 %rd12, %rd5, %rd7;
    add.s64 %rd13, %rd6, %rd7;

    ld.global.f32 %f1, [%rd8];     // alpha
    ld.global.f32 %f2, [%rd9];     // beta raw
    ld.global.f32 %f3, [%rd10];    // dt bias
    ld.global.f32 %f4, [%rd11];    // ssm_a

    mov.f32 %f5, 0fBFB8AA3B;       // -log2(e)
    mul.rn.f32 %f6, %f2, %f5;
    ex2.approx.ftz.f32 %f7, %f6;
    mov.f32 %f8, 0f3F800000;
    add.rn.f32 %f9, %f8, %f7;
    rcp.approx.ftz.f32 %f10, %f9;
    st.global.f32 [%rd13], %f10;

    add.rn.f32 %f11, %f1, %f3;     // xi
    mov.f32 %f12, 0f3FB8AA3B;      // log2(e)
    mul.rn.f32 %f13, %f11, %f12;
    ex2.approx.ftz.f32 %f14, %f13; // exp(xi)
    add.rn.f32 %f15, %f8, %f14;
    lg2.approx.ftz.f32 %f16, %f15;
    mov.f32 %f17, 0f3F317218;      // ln(2)
    mul.rn.f32 %f18, %f16, %f17;   // softplus approx
    mul.rn.f32 %f19, %f18, %f4;
    mul.rn.f32 %f20, %f19, %f12;
    ex2.approx.ftz.f32 %f21, %f20;
    st.global.f32 [%rd12], %f21;

AB_DONE:
    ret;
}

// Serial correctness-first RMSNorm over one vector:
//   out[i] = x[i] * rsqrt(mean(x^2) + eps) * norm[i]
.visible .entry rmsnorm_vec_probe(
    .param .u64 x,
    .param .u64 norm,
    .param .u64 out,
    .param .u32 dim,
    .param .f32 eps
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<18>;
    .reg .f32 %f<16>;

    ld.param.u64 %rd1, [x];
    ld.param.u64 %rd2, [norm];
    ld.param.u64 %rd3, [out];
    ld.param.u32 %r1, [dim];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %tid.x;
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra RMS_DONE;

    mov.f32 %f2, 0f00000000;
    mov.u32 %r3, 0;
RMS_SUM:
    setp.ge.u32 %p2, %r3, %r1;
    @%p2 bra RMS_INV;
    mul.wide.u32 %rd4, %r3, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f3, [%rd5];
    fma.rn.f32 %f2, %f3, %f3, %f2;
    add.u32 %r3, %r3, 1;
    bra RMS_SUM;

RMS_INV:
    cvt.rn.f32.u32 %f4, %r1;
    div.rn.f32 %f5, %f2, %f4;
    add.rn.f32 %f5, %f5, %f1;
    sqrt.rn.f32 %f6, %f5;
    rcp.rn.f32 %f7, %f6;
    mov.u32 %r4, 0;

RMS_WRITE:
    setp.ge.u32 %p3, %r4, %r1;
    @%p3 bra RMS_DONE;
    mul.wide.u32 %rd6, %r4, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd9, %rd3, %rd6;
    ld.global.f32 %f8, [%rd7];
    ld.global.f32 %f9, [%rd8];
    mul.rn.f32 %f10, %f8, %f7;
    mul.rn.f32 %f11, %f10, %f9;
    st.global.f32 [%rd9], %f11;
    add.u32 %r4, %r4, 1;
    bra RMS_WRITE;

RMS_DONE:
    ret;
}

// residual_out = x + add; normed_out = RMSNorm(residual_out, norm).
.visible .entry add_rmsnorm_vec_probe(
    .param .u64 x,
    .param .u64 add,
    .param .u64 norm,
    .param .u64 residual_out,
    .param .u64 normed_out,
    .param .u32 dim,
    .param .f32 eps
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<12>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<18>;

    ld.param.u64 %rd1, [x];
    ld.param.u64 %rd2, [add];
    ld.param.u64 %rd3, [norm];
    ld.param.u64 %rd4, [residual_out];
    ld.param.u64 %rd5, [normed_out];
    ld.param.u32 %r1, [dim];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %tid.x;
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra ADDRMS_DONE;

    mov.f32 %f2, 0f00000000;
    mov.u32 %r3, 0;
ADDRMS_SUM:
    setp.ge.u32 %p2, %r3, %r1;
    @%p2 bra ADDRMS_INV;
    mul.wide.u32 %rd6, %r3, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd9, %rd4, %rd6;
    ld.global.f32 %f3, [%rd7];
    ld.global.f32 %f4, [%rd8];
    add.rn.f32 %f5, %f3, %f4;
    st.global.f32 [%rd9], %f5;
    fma.rn.f32 %f2, %f5, %f5, %f2;
    add.u32 %r3, %r3, 1;
    bra ADDRMS_SUM;

ADDRMS_INV:
    cvt.rn.f32.u32 %f6, %r1;
    div.rn.f32 %f7, %f2, %f6;
    add.rn.f32 %f7, %f7, %f1;
    sqrt.rn.f32 %f8, %f7;
    rcp.rn.f32 %f9, %f8;
    mov.u32 %r4, 0;

ADDRMS_WRITE:
    setp.ge.u32 %p3, %r4, %r1;
    @%p3 bra ADDRMS_DONE;
    mul.wide.u32 %rd10, %r4, 4;
    add.s64 %rd11, %rd4, %rd10;
    add.s64 %rd12, %rd3, %rd10;
    add.s64 %rd13, %rd5, %rd10;
    ld.global.f32 %f10, [%rd11];
    ld.global.f32 %f11, [%rd12];
    mul.rn.f32 %f12, %f10, %f9;
    mul.rn.f32 %f13, %f12, %f11;
    st.global.f32 [%rd13], %f13;
    add.u32 %r4, %r4, 1;
    bra ADDRMS_WRITE;

ADDRMS_DONE:
    ret;
}

// Parallel RMSNorm over one vector. Launch: grid=(1), block=(256).
.visible .entry rmsnorm_vec_parallel_probe(
    .param .u64 x,
    .param .u64 norm,
    .param .u64 out,
    .param .u32 dim,
    .param .f32 eps
)
{
    .reg .pred %p<10>;
    .reg .b32 %r<20>;
    .reg .b64 %rd<24>;
    .reg .f32 %f<20>;
    .shared .align 4 .b8 smem[1024];

    ld.param.u64 %rd1, [x];
    ld.param.u64 %rd2, [norm];
    ld.param.u64 %rd3, [out];
    ld.param.u32 %r1, [dim];
    ld.param.f32 %f1, [eps];

    mov.u32 %r2, %tid.x;
    mov.u32 %r3, %ntid.x;
    mov.f32 %f2, 0f00000000;
    mov.u32 %r4, %r2;

RMSP_SUM:
    setp.ge.u32 %p1, %r4, %r1;
    @%p1 bra RMSP_STORE_SUM;
    mul.wide.u32 %rd4, %r4, 4;
    add.s64 %rd5, %rd1, %rd4;
    ld.global.f32 %f3, [%rd5];
    fma.rn.f32 %f2, %f3, %f3, %f2;
    add.u32 %r4, %r4, %r3;
    bra RMSP_SUM;

RMSP_STORE_SUM:
    mul.wide.u32 %rd6, %r2, 4;
    cvta.shared.u64 %rd7, smem;
    add.s64 %rd8, %rd7, %rd6;
    st.shared.f32 [%rd8], %f2;
    bar.sync 0;

    setp.ge.u32 %p2, %r2, 128;
    @%p2 bra RMSP_R128_DONE;
    add.u32 %r5, %r2, 128;
    mul.wide.u32 %rd9, %r5, 4;
    add.s64 %rd10, %rd7, %rd9;
    ld.shared.f32 %f4, [%rd10];
    add.rn.f32 %f2, %f2, %f4;
    st.shared.f32 [%rd8], %f2;
RMSP_R128_DONE:
    bar.sync 0;

    setp.ge.u32 %p3, %r2, 64;
    @%p3 bra RMSP_R64_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r6, %r2, 64;
    mul.wide.u32 %rd11, %r6, 4;
    add.s64 %rd12, %rd7, %rd11;
    ld.shared.f32 %f5, [%rd12];
    add.rn.f32 %f2, %f2, %f5;
    st.shared.f32 [%rd8], %f2;
RMSP_R64_DONE:
    bar.sync 0;

    setp.ge.u32 %p4, %r2, 32;
    @%p4 bra RMSP_R32_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r7, %r2, 32;
    mul.wide.u32 %rd13, %r7, 4;
    add.s64 %rd14, %rd7, %rd13;
    ld.shared.f32 %f6, [%rd14];
    add.rn.f32 %f2, %f2, %f6;
    st.shared.f32 [%rd8], %f2;
RMSP_R32_DONE:
    bar.sync 0;

    setp.ge.u32 %p5, %r2, 16;
    @%p5 bra RMSP_R16_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r8, %r2, 16;
    mul.wide.u32 %rd15, %r8, 4;
    add.s64 %rd16, %rd7, %rd15;
    ld.shared.f32 %f7, [%rd16];
    add.rn.f32 %f2, %f2, %f7;
    st.shared.f32 [%rd8], %f2;
RMSP_R16_DONE:
    bar.sync 0;

    setp.ge.u32 %p6, %r2, 8;
    @%p6 bra RMSP_R8_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r9, %r2, 8;
    mul.wide.u32 %rd17, %r9, 4;
    add.s64 %rd18, %rd7, %rd17;
    ld.shared.f32 %f8, [%rd18];
    add.rn.f32 %f2, %f2, %f8;
    st.shared.f32 [%rd8], %f2;
RMSP_R8_DONE:
    bar.sync 0;

    setp.ge.u32 %p7, %r2, 4;
    @%p7 bra RMSP_R4_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r10, %r2, 4;
    mul.wide.u32 %rd19, %r10, 4;
    add.s64 %rd20, %rd7, %rd19;
    ld.shared.f32 %f9, [%rd20];
    add.rn.f32 %f2, %f2, %f9;
    st.shared.f32 [%rd8], %f2;
RMSP_R4_DONE:
    bar.sync 0;

    setp.ge.u32 %p8, %r2, 2;
    @%p8 bra RMSP_R2_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.u32 %r11, %r2, 2;
    mul.wide.u32 %rd21, %r11, 4;
    add.s64 %rd22, %rd7, %rd21;
    ld.shared.f32 %f10, [%rd22];
    add.rn.f32 %f2, %f2, %f10;
    st.shared.f32 [%rd8], %f2;
RMSP_R2_DONE:
    bar.sync 0;

    setp.ge.u32 %p9, %r2, 1;
    @%p9 bra RMSP_INV_DONE;
    ld.shared.f32 %f2, [%rd8];
    add.s64 %rd23, %rd8, 4;
    ld.shared.f32 %f11, [%rd23];
    add.rn.f32 %f2, %f2, %f11;
    cvt.rn.f32.u32 %f12, %r1;
    div.rn.f32 %f13, %f2, %f12;
    add.rn.f32 %f13, %f13, %f1;
    sqrt.rn.f32 %f14, %f13;
    rcp.rn.f32 %f15, %f14;
    st.shared.f32 [%rd7], %f15;
RMSP_INV_DONE:
    bar.sync 0;

    ld.shared.f32 %f16, [%rd7];
    mov.u32 %r12, %r2;
RMSP_WRITE:
    setp.ge.u32 %p1, %r12, %r1;
    @%p1 bra RMSP_DONE;
    mul.wide.u32 %rd4, %r12, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd9, %rd2, %rd4;
    add.s64 %rd10, %rd3, %rd4;
    ld.global.f32 %f3, [%rd5];
    ld.global.f32 %f4, [%rd9];
    mul.rn.f32 %f5, %f3, %f16;
    mul.rn.f32 %f6, %f5, %f4;
    st.global.f32 [%rd10], %f6;
    add.u32 %r12, %r12, %r3;
    bra RMSP_WRITE;

RMSP_DONE:
    ret;
}

// Parallel residual add + RMSNorm. Launch: grid=(1), block=(256).
.visible .entry add_rmsnorm_vec_parallel_probe(
