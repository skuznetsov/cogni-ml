    ld.shared.f32 %f2, [%rd12];
    add.u32 %r10, %r2, 4;
    mul.wide.u32 %rd23, %r10, 4;
    add.s64 %rd24, %rd11, %rd23;
    ld.shared.f32 %f11, [%rd24];
