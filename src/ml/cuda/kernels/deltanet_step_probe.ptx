    ld.shared.f32 %f2, [%rd12];
    add.u32 %r8, %r2, 16;
    mul.wide.u32 %rd19, %r8, 4;
    add.s64 %rd20, %rd11, %rd19;
    ld.shared.f32 %f9, [%rd20];
    add.rn.f32 %f2, %f2, %f9;
