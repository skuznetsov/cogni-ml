    ld.global.f32 %f1, [%rd6];
    ld.global.f32 %f2, [%rd7];
    neg.f32 %f3, %f1;
    mul.rn.f32 %f3, %f3, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %f4, %f3;
    add.rn.f32 %f4, %f4, 0f3F800000;
    rcp.approx.ftz.f32 %f4, %f4;
    mul.rn.f32 %f1, %f1, %f4;
    mul.rn.f32 %f1, %f1, %f2;
    st.global.f32 [%rd8], %f1;
SWIGLU_DONE:
