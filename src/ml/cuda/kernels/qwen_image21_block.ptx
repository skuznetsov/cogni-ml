    @%p1 bra SWIGLU_DONE;
    setp.ge.u32 %p2, %r6, %r2;
    @%p2 bra SWIGLU_DONE;
    shl.b32 %r10, %r2, 1;
    mad.lo.u32 %r11, %r3, %r10, %r6;
